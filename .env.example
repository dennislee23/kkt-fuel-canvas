# Copy to `.env` on the server and fill in real values.
# `.env` is gitignored and blocked by .htaccess — never commit it.

# Deploy key — long random string. Used by deploy.php / update.html.
# Generate with: openssl rand -hex 32
DEPLOY_KEY=

# Anthropic API key — used by api/advisor.php to call Claude.
# USE A DEDICATED KEY for fuelretail (NOT the shared key used by fuel/alfa/
# Optimus/retail). A separate key is the only way the Anthropic Console
# attributes spend to this app — a shared key drains one balance across all
# apps with no per-app visibility. Create one at console.anthropic.com.
# Read server-side only; never sent to the browser.
ANTHROPIC_API_KEY=

# Optional: override the Claude model. Defaults to claude-haiku-4-5 (cheapest
# tier — public advisor on your billing). Set to claude-sonnet-4-5 for higher
# answer quality at ~3-4x the cost.
# CLAUDE_MODEL=

# Optional cost controls (advisor.php) — tunable here without a redeploy.
#   ADVISOR_DAILY_CAP — max live Claude calls/day across ALL visitors. Above it
#     the advisor serves a "limit reached" message and makes no call: a hard
#     ceiling on the daily bill even under IP rotation. Default 300, 0 disables.
#   ADVISOR_CACHE_TTL — seconds an answer is cached for an identical question.
#     Default 21600 (6h), 0 disables.
# ADVISOR_DAILY_CAP=300
# ADVISOR_CACHE_TTL=21600
