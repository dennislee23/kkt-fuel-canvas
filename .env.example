# Copy to `.env` on the server and fill in real values.
# `.env` is gitignored and blocked by .htaccess — never commit it.

# Deploy key — long random string. Used by deploy.php / update.html.
# Generate with: openssl rand -hex 32
DEPLOY_KEY=

# Anthropic API key — used by api/advisor.php to call Claude.
# Same key already in use for Optimus / retail — copy from there.
# Without it, the advisor returns a friendly "unavailable" message.
ANTHROPIC_API_KEY=

# Optional: override the Claude model (defaults to claude-sonnet-4-5).
# CLAUDE_MODEL=
